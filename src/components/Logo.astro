---
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
const favicon = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`;
---

<a href="#top" class="flex items-center gap-2.5" aria-label="Choice Therapeutics home">
  <img src={favicon} alt="" width="36" height="36" class="size-9" />
  <span class="leading-none">
    <span class:list={['block text-lg font-extrabold tracking-tight', dark ? 'text-white' : 'text-navy-950']}>Choice</span>
    <span class:list={['block text-[11px] font-semibold uppercase tracking-[0.2em]', dark ? 'text-teal-300' : 'text-teal-600']}>Therapeutics</span>
  </span>
</a>
