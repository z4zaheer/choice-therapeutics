---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import equipment from '../assets/images/equipment.jpg';
import outreach from '../assets/images/outreach.jpg';
import mentoring from '../assets/images/mentoring.jpg';

const services = [
  {
    icon: 'stethoscope',
    title: 'Sales of Medical Equipment',
    text: 'Diagnostic, monitoring, theatre and hospital equipment, plus consumables, sourced from reputable manufacturers and backed by support.',
    image: equipment,
    alt: 'Clean clinic room with medical equipment',
    href: '#equipment',
    cta: 'Request a quote',
    interest: 'Equipment quote',
  },
  {
    icon: 'users',
    title: 'Outreach Programs',
    text: 'Community health screenings, health education and medical supply support that bring quality care to people who need it most.',
    image: outreach,
    alt: 'Health worker checking a woman’s blood pressure during an outreach',
    href: '#outreach',
    cta: 'Partner with us',
    interest: 'Outreach partnership',
  },
  {
    icon: 'graduation',
    title: 'Clinical Mentoring',
    text: 'Practical, hands-on mentoring and equipment training that helps clinicians and teams deliver safer, more confident care.',
    image: mentoring,
    alt: 'Clinician mentoring a colleague in front of a diagnostic screen',
    href: '#mentoring',
    cta: 'Enquire about mentoring',
    interest: 'Clinical mentoring',
  },
] as const;
---

<section id="services" class="bg-slate-50 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-bold uppercase tracking-widest text-teal-600">What We Do</p>
      <h2 class="mt-3 text-3xl font-extrabold sm:text-4xl">Complete support for better healthcare</h2>
      <p class="mt-4 text-lg text-slate-600">
        From the equipment on your ward to the skills of your team and the health of your community, we help you deliver care with confidence.
      </p>
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <article class="group flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-navy-900/10">
            <div class="relative overflow-hidden">
              <Image
                src={s.image}
                alt={s.alt}
                widths={[400, 700]}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-105"
              />
              <span class="absolute -bottom-6 left-6 flex size-14 items-center justify-center rounded-2xl bg-gradient-to-br from-teal-500 to-blue-700 text-white shadow-lg ring-4 ring-white">
                <Icon name={s.icon} class="size-7" />
              </span>
            </div>
            <div class="flex flex-1 flex-col p-6 pt-10">
              <h3 class="text-xl font-bold">{s.title}</h3>
              <p class="mt-3 flex-1 leading-relaxed text-slate-600">{s.text}</p>
              <div class="mt-6 flex items-center justify-between gap-4">
                <a href="#contact" data-interest={s.interest} class="inline-flex items-center gap-1.5 font-semibold text-teal-700 hover:text-teal-800">
                  {s.cta} <Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
                </a>
                <a href={s.href} class="text-sm font-medium text-slate-500 hover:text-navy-800">Learn more</a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
