---
import Icon from './Icon.astro';
---

<div id="sticky-cta" class="invisible fixed inset-x-0 bottom-0 z-40 translate-y-full opacity-0 transition-all duration-300 lg:inset-x-auto lg:right-6 lg:bottom-6">
  <div class="flex gap-3 border-t border-slate-200 bg-white/95 p-3 shadow-[0_-8px_30px_rgba(6,20,43,0.12)] backdrop-blur lg:rounded-full lg:border-0 lg:bg-transparent lg:p-0 lg:shadow-none">
    <a href="mailto:ayomideadeyeye21@gmail.com" class="flex flex-1 items-center justify-center gap-2 rounded-full border border-navy-100 bg-white px-4 py-3 font-semibold text-navy-900 lg:hidden">
      <Icon name="mail" class="size-5 text-teal-600" /> Email
    </a>
    <a
      href="#contact"
      data-interest="Equipment quote"
      class="flex flex-[2] items-center justify-center gap-2 rounded-full bg-teal-600 px-6 py-3 font-semibold text-white shadow-lg shadow-teal-600/30 transition hover:bg-teal-700 lg:py-4 lg:shadow-xl"
    >
      <Icon name="message" class="size-5" /> Request a Quote
    </a>
  </div>
</div>

<script>
  const cta = document.getElementById('sticky-cta')!;
  const contact = document.getElementById('contact')!;
  let pastHero = false;
  let atContact = false;
  const update = () => {
    const hidden = !pastHero || atContact;
    ['translate-y-full', 'opacity-0', 'invisible'].forEach((c) => cta.classList.toggle(c, hidden));
  };
  const onScroll = () => {
    pastHero = window.scrollY > 500;
    update();
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  new IntersectionObserver(([entry]) => {
    atContact = entry.isIntersecting;
    update();
  }, { threshold: 0.15 }).observe(contact);
</script>
