---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const links = [
  { href: '#services', label: 'What We Do' },
  { href: '#equipment', label: 'Equipment' },
  { href: '#outreach', label: 'Outreach' },
  { href: '#mentoring', label: 'Mentoring' },
  { href: '#why-us', label: 'Why Us' },
];
---

<header id="site-header" class="sticky top-0 z-50 border-b border-slate-200/70 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between px-5 sm:px-8">
    <Logo />
    <nav class="hidden items-center gap-8 text-sm font-medium text-slate-600 lg:flex" aria-label="Main">
      {links.map((l) => <a href={l.href} class="transition hover:text-teal-600">{l.label}</a>)}
    </nav>
    <div class="flex items-center gap-3">
      <a href="#contact" class="hidden text-sm font-semibold text-navy-800 hover:text-teal-600 sm:inline">Contact</a>
      <a
        href="#contact"
        data-interest="Equipment quote"
        class="hidden rounded-full bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm shadow-teal-600/30 transition hover:bg-teal-700 sm:inline-flex"
      >
        Request a Quote
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-lg text-navy-900 hover:bg-slate-100 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" class="size-6 menu-open" />
        <Icon name="close" class="hidden size-6 menu-close" />
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-5 pb-6 pt-2 lg:hidden" aria-label="Mobile">
    <ul class="flex flex-col">
      {
        [...links, { href: '#contact', label: 'Contact' }].map((l) => (
          <li>
            <a href={l.href} class="block border-b border-slate-100 py-3.5 text-base font-medium text-navy-900">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="#contact"
      data-interest="Equipment quote"
      class="mt-5 flex w-full items-center justify-center rounded-full bg-teal-600 px-5 py-3 font-semibold text-white"
    >
      Request a Quote
    </a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const setOpen = (open: boolean) => {
    menu.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.menu-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close')!.classList.toggle('hidden', !open);
  };
  toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
