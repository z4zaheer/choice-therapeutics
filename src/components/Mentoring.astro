---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import mentoring from '../assets/images/mentoring.jpg';

const programs = [
  { icon: 'graduation', title: 'Hands-on clinical mentoring', text: 'Guided, practical learning alongside experienced clinicians.' },
  { icon: 'wrench', title: 'Equipment training', text: 'Confident, safe use of the equipment you buy from us and beyond.' },
  { icon: 'clipboard', title: 'Skills & protocol refreshers', text: 'Focused sessions that keep teams aligned with best practice.' },
  { icon: 'users', title: 'Team & facility programs', text: 'Tailored mentoring for clinics, hospitals and student cohorts.' },
] as const;
---

<section id="mentoring" class="py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="overflow-hidden rounded-[2rem] bg-navy-950 text-white">
      <div class="grid lg:grid-cols-2">
        <div class="p-8 sm:p-12 lg:p-16">
          <p class="text-sm font-bold uppercase tracking-widest text-teal-300">Clinical Mentoring</p>
          <h2 class="mt-3 text-3xl font-extrabold text-white sm:text-4xl">Building confident, capable clinicians</h2>
          <p class="mt-4 text-lg leading-relaxed text-navy-100">
            Equipment is only as good as the hands that use it. Our mentoring programs pair healthcare workers with experienced
            professionals to strengthen practical skills and improve patient outcomes.
          </p>
          <div class="mt-9 grid gap-6 sm:grid-cols-2">
            {
              programs.map((p) => (
                <div>
                  <span class="flex size-11 items-center justify-center rounded-xl bg-white/10 text-teal-300">
                    <Icon name={p.icon} class="size-5" />
                  </span>
                  <h3 class="mt-3 font-bold text-white">{p.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-navy-100">{p.text}</p>
                </div>
              ))
            }
          </div>
          <a href="#contact" data-interest="Clinical mentoring" class="mt-10 inline-flex items-center gap-2 rounded-full bg-teal-500 px-7 py-3.5 font-semibold text-navy-950 transition hover:bg-teal-400">
            Enquire about mentoring <Icon name="arrow" class="size-4" />
          </a>
        </div>
        <div class="relative min-h-72 lg:min-h-full">
          <Image src={mentoring} alt="Senior clinician mentoring a colleague" widths={[600, 1000]} sizes="(min-width: 1024px) 50vw, 100vw" class="absolute inset-0 size-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-950/60 to-transparent lg:bg-gradient-to-r lg:from-navy-950 lg:via-navy-950/10"></div>
        </div>
      </div>
    </div>
  </div>
</section>
